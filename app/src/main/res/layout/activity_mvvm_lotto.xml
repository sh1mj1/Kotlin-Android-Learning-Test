<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="viewModel"
            type="com.example.learningtest.solid.an.LottoViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="환영합니다! 로또 판매자를 선택해주세요."
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <RadioGroup
            android:id="@+id/radioSellerGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:onCheckedChanged="@{(group, checkedId) -> viewModel.updateSeller(checkedId)}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtTitle">

            <RadioButton
                android:id="@+id/radioNormalSeller"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="일반 로또 판매자 (1000원)" />

            <RadioButton
                android:id="@+id/radioDiscountSeller"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="할인 로또 판매자 (500원)" />

            <RadioButton
                android:id="@+id/radioVendingNormal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="일반 로또 자판기 (1000원)" />

            <RadioButton
                android:id="@+id/radioVendingNoisy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="시끄러운 로또 자판기 (1000원)" />
        </RadioGroup>

        <EditText
            android:id="@+id/inputMoney"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="구매할 금액을 입력하세요"
            android:inputType="number"
            android:padding="12dp"
            android:text="@={viewModel.money}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/radioSellerGroup" />

        <RadioGroup
            android:id="@+id/radioShapeGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:onCheckedChanged="@{(group, checkedId) -> viewModel.updateShape(checkedId)}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/inputMoney">

            <RadioButton
                android:id="@+id/radioRectangle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="직사각형" />

            <RadioButton
                android:id="@+id/radioSquare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="정사각형" />
        </RadioGroup>

        <EditText
            android:id="@+id/inputWidth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="가로 길이를 입력하세요"
            android:inputType="number"
            android:padding="12dp"
            android:text="@={viewModel.width}"
            android:visibility="@{viewModel.showWidth}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/radioShapeGroup" />

        <EditText
            android:id="@+id/inputHeight"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="세로 길이를 입력하세요"
            android:inputType="number"
            android:padding="12dp"
            android:text="@={viewModel.height}"
            android:visibility="@{viewModel.showHeight}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/inputWidth" />

        <RadioGroup
            android:id="@+id/radioLottoTypeGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:onCheckedChanged="@{(group, checkedId) -> viewModel.updateLottoType(checkedId)}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/inputHeight">

            <RadioButton
                android:id="@+id/radioAuto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="자동 생성" />

            <RadioButton
                android:id="@+id/radioManual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="수동 입력" />
        </RadioGroup>

        <EditText
            android:id="@+id/inputManualNumbers"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="6개의 숫자를 쉼표로 구분하여 입력하세요"
            android:inputType="text"
            android:padding="12dp"
            android:text="@={viewModel.manualNumbers}"
            android:visibility="@{viewModel.showManualNumbers}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/radioLottoTypeGroup" />

        <Button
            android:id="@+id/btnBuyLotto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:onClick="@{() -> viewModel.buyLotto()}"
            android:padding="12dp"
            android:text="로또 구매"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/inputManualNumbers" />

        <TextView
            android:id="@+id/txtResult"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="16dp"
            android:text="@{viewModel.result}"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnBuyLotto" />

        <TextView
            android:id="@+id/txtError"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="8dp"
            android:text="@{viewModel.error}"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="@{viewModel.showError}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnBuyLotto" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>