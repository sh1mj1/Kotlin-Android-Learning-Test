<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.INTERNET" />


    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LearningTest"
        tools:targetApi="31">
        <activity
            android:name=".fourComponents.contentprovider.systemcontent.ContactsActivity"
            android:exported="true"
            android:label="@string/title_activity_contacts"
            android:theme="@style/Theme.LearningTest" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".fourComponents.contentprovider.customcontent.ShipmentActivity"
            android:exported="true"
            android:label="@string/title_activity_shipment"
            android:theme="@style/Theme.LearningTest" />
        <activity
            android:name=".fourComponents.broadcast.static.AlarmActivity"
            android:exported="true"
            android:label="@string/title_activity_alarm"
            android:theme="@style/Theme.LearningTest" />
        <activity
            android:name=".fourComponents.broadcast.dynamic.NetworkActivity"
            android:exported="true"
            android:label="@string/title_activity_network"
            android:theme="@style/Theme.LearningTest" />
        <activity
            android:name=".compose.basiclayout.SootheActivity"
            android:exported="true"
            android:label="@string/title_activity_soothe"
            android:theme="@style/Theme.LearningTest" />
        <activity
            android:name=".fourComponents.service.foregroundboud.ForegroundBoundMusicActivity"
            android:exported="true"
            android:label="@string/title_activity_music_player"
            android:theme="@style/Theme.LearningTest" />
        <activity
            android:name=".compose.state.BasicStateActivity"
            android:exported="true"
            android:label="@string/title_activity_basic_state"
            android:theme="@style/Theme.LearningTest" />
        <activity
            android:name=".compose.basic.codelab.BasicComposeActivity"
            android:exported="true"
            android:label="@string/title_activity_main2"
            android:theme="@style/Theme.LearningTest" />
        <activity
            android:name=".fourComponents.service.bound.SimpleBoundMusicActivity"
            android:exported="true" />
        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <service
            android:name=".fourComponents.service.bound.SimpleBoundMusicService"
            android:exported="false" />
        <service
            android:name=".fourComponents.service.foregroundboud.ForegroundBoundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name=".fourComponents.broadcast.static.NotificationReceiver"
            android:exported="false" />

        <provider
            android:name=".fourComponents.contentprovider.customcontent.ShipmentContentProvider"
            android:authorities="com.other.shipment.provider"
            android:exported="false" />
    </application>

</manifest>